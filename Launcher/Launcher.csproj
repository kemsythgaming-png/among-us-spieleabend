<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Launcher fuer Freunde: eine einzige EXE.
    - .NET Framework 4.8 (in Windows 10/11 eingebaut) -> nichts zusaetzlich installieren
    - enthaelt BepInEx + Mod als eingebettetes Zip (dist\ModPackage.zip, erzeugt von Verteilung\Paket-bauen.ps1)
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>AmongUsSpieleabend.Launcher</AssemblyName>
    <RootNamespace>Spieleabend.Launcher</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationIcon>launcher.ico</ApplicationIcon>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.CSharp" />
    <EmbeddedResource Include="..\dist\ModPackage.zip" LogicalName="ModPackage.zip" Condition="Exists('..\dist\ModPackage.zip')" />
  </ItemGroup>

</Project>
